{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.hasChildren(['displayName','language','category','newLearner','updatedAt'])",
          "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "language": { ".validate": "newData.val() === 'ar' || newData.val() === 'en'" },
          "category": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
          "newLearner": { ".validate": "newData.isBoolean()" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        },
        "results": { ".write": false },
        "progress": { ".write": false }
      }
    },
    "onlinePrivate": { ".read": false, ".write": false }
  }
}
