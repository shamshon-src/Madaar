# local: explicit, in-memory test rooms. firebase: real verified users and RTDB.
ONLINE_BACKEND=local
PORT=5700
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5600,http://localhost:5600,https://madaar-web-game.web.app,https://madaar-web-game.firebaseapp.com
